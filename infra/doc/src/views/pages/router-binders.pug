extends ../layouts/page

block append head
  - pageTitle = "Router Binders"

block title
  | Router Binders

block page-content
  section.my-5#route-binder
    h2 rv-route
    != md('reference/router/binders/route.md')

  section.my-5#route-class-binder
    h2 rv-route-class-*
    != md('reference/router/binders/route-class-[classname].md')

  section.my-5#parent-route-class-binder
    h2 rv-parent-route-class-*
    != md('reference/router/binders/parent-route-class-[classname].md')

  section.my-5#route-preload-binder
    h2 rv-route-preload
    != md('reference/router/binders/route-preload.md')

  section.my-5#route-back-on-binder
    h2 rv-route-back-on-*
    != md('reference/router/binders/route-back-on-star.md')
