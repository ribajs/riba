extends ../layouts/page

block append head
  - pageTitle = "Core Binders"

block title
  | Core Binders

block page-content

  section.my-5#add-class-binder
    h2 add-class
    != md('reference/core/binders/add-class.md')

  section.my-5#remove-class-binder
    h2 remove-class
    != md('reference/core/binders/remove-class.md')

  section.my-5#assign-binder
    h2 assign
    != md('reference/core/binders/assign.md')

  section.my-5#assign-property-binder
    h2 assign-[property]
    != md('reference/core/binders/assign-[property].md')

  section.my-5#attribute-binder
    h2 [attribute]
    != md('reference/core/binders/[attribute].md')

  section.my-5#block-binder
    h2 block
    != md('reference/core/binders/block.md')

  section.my-5#checked-binder
    h2 checked
    != md('reference/core/binders/checked.md')

  section.my-5#unchecked-binder
    h2 unchecked
    != md('reference/core/binders/unchecked.md')

  section.my-5#class-classname-binder
    h2 class-[classname]
    != md('reference/core/binders/class-[classname].md')

  section.my-5#disabled-binder
    h2 disabled
    != md('reference/core/binders/disabled.md')

  section.my-5#enabled-binder
    h2 enabled
    != md('reference/core/binders/enabled.md')

  section.my-5#each-item-binder
    h2 each-[item]
    != md('reference/core/binders/each-[item]/each-[item].md')
    include ../../doc/demos/core-each-[item]

  section.my-5#nested-each-item-binder
    h2 Nested each-[item]
    != md('reference/core/binders/each-[item]/nested-each-[item].md')

  section.my-5#hide-binder
    h2 hide
    != md('reference/core/binders/hide.md')

  section.my-5#show-binder
    h2 show
    != md('reference/core/binders/show.md')

  section.my-5#html-binder
    h2 html
    != md('reference/core/binders/html.md')

  section.my-5#text-binder
    h2 text
    != md('reference/core/binders/text.md')

  section.my-5#template-binder
    h2 template
    != md('reference/core/binders/template.md')

  section.my-5#if-binder
    h2 if
    != md('reference/core/binders/if.md')

  section.my-5#unless-binder
    h2 unless
    != md('reference/core/binders/unless.md')

  section.my-5
    h2#on-event-binder on-[event]
    != md('reference/core/binders/on-[event].md')

  section.my-5#srcset-size-binder
    h2 srcset-[size]
    != md('reference/core/binders/srcset-[size].md')

  section.my-5#style-property-binder
    h2 style-property
    != md('reference/core/binders/style-[property].md')

  section.my-5#value-binder
    h2 value
    != md('reference/core/binders/value.md')
