extends ../layouts/page

block append head
  - pageTitle = "Extras Module"

block title
  | Extras Module

block page-content

  section.my-5
    != md('../../../../packages/extras/README.md')

  section.my-5#binders
    h2 Binders

    section.my-5#data-scroll-position-y-binder
      h3 data-scroll-position-y
      != md('reference/extras/binders/data-scroll-position-y.md')

    section.my-5#touch-events-binder
      h3 touch-events
      != md('reference/extras/binders/touch-events.md')
      include ../../doc/demos/extras-touch-events

    section.my-5#scroll-events-binder
      h3 scroll-events
      != md('reference/extras/binders/scroll-events.md')
      include ../../doc/demos/extras-scroll-events

  section.my-5#services
    h2 Services

    section.my-5#touch-events-service
      h3 TouchEventsService
      section
        != md('reference/extras/services/touch-events-service.md')

    section.my-5#scroll-events-service
      h3 ScrollEventsService
      section
        != md('reference/extras/services/scroll-events-service.md')
